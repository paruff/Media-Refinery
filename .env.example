
# Example environment variables for Media-Refinery
# Copy to .env and edit as needed
# Read by docker compose for ${...} substitution (see docs/DEPLOYMENT.md)
MR_API_TOKEN=change-me
PUID=1000
PGID=1000
TZ=UTC
WORK_DIR=./work
ARCHIVE_DIR=./archive
QUARANTINE_DIR=./quarantine
DATA_DIR=./data

INPUT_DIR=./input
OUTPUT_DIR=./output
DRY_RUN=false
# Lead type is music; add movie,series,audiobook,ebook to opt in to experimental types
ENABLED_TYPES=["music"]
TMDB_API_KEY=your_tmdb_key
ACOUSTID_API_KEY=your_acoustid_key
TVDB_API_KEY=your_tvdb_key
AUDIOBOOKS_ROOT=./output/Audiobooks
CALIBRE_LIBRARY=./output/Books
EBOOK_FETCH_METADATA=true
# Optional server rescans (R-NOTIFY); leave URL empty to disable
PLEX_URL=
PLEX_TOKEN=
PLEX_SECTIONS={"movie":"1","series":"2","music":"3"}
JELLYFIN_URL=
JELLYFIN_API_KEY=
ABS_URL=
ABS_TOKEN=
ABS_LIBRARY_ID=
MUSIC_ASSISTANT_URL=
MUSIC_ASSISTANT_TOKEN=
# Container path -> media-server path (Plex/Jellyfin scan folders by the server's own path)
NOTIFY_PATH_MAP={"/output/Music":"/data/music","/output/Movies":"/data/movies","/output/TV":"/data/tv"}
