            "title": "Source Path",
            "type": "string"
          },
          "state": {
            "$ref": "#/components/schemas/FileState"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "updated_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Updated At"
          },
          "verification": {
            "items": {
              "$ref": "#/components/schemas/VerificationOut"
            },
            "title": "Verification",
            "type": "array"
          }
        },
        "required": [
          "id",
          "source_path",
          "state",
          "media_type",
          "log",
          "verification"
        ],
        "title": "ItemDetail",
        "type": "object"
      },
      "ItemOut": {
