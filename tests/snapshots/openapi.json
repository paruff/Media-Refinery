            },
            "title": "Checks",
            "type": "array"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "output_sha256": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
