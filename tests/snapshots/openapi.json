      "FileState": {
        "enum": [
          "pending",
          "scanning",
          "scanned",
          "enriched",
          "planned",
          "approved",
          "executing",
          "executed",
          "verified",
          "published",
          "validated",
          "audited",
          "quarantined",
          "error"
        ],
        "title": "FileState",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
